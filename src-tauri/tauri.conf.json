{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "习惯追踪器",
  "version": "1.0.0",
  "identifier": "com.habit-tracker.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "习惯追踪器",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "HabitTracker",
    "category": "Productivity",
    "shortDescription": "一个简单高效的习惯追踪应用",
    "longDescription": "专为个人设计的习惯追踪应用，帮助你建立和维持良好习惯。支持项目目标设定、进度追踪、数据可视化等功能。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://releases.tauri.app/{{current_version}}"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MEU0MjI0RjVDNjE5RkYKUldSV0IrSUhSS1R1ZC8yQ3l2K3lGNVR4Smh6ZGh2OHQ4U0s2bDE0bDlhNkN1YlJzZ1YvMUdTNzJRND0K"
    }
  }
}